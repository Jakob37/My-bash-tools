#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf '%s\n' \
        "Usage: ${0##*/} [-n N] [-l LABELS] [-o DIR] [--] FILE1 FILE2 [FILE ...]" \
        'Compare distinct lines and report all-file, pairwise and exact overlaps.' \
        '  -n, --hits N          Show up to N sorted lines per exact split (default: 0).' \
        '  -l, --labels LABELS   Use comma-separated labels in input order (e.g. GroupA,GroupB,GroupC).' \
        '  -o, --output-dir DIR  Write the summary and complete line lists to a new directory.'
}

hit_limit=0
label_list=
output_dir=
files=()
while (($#)); do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -n|--hits)
            if [[ $# -lt 2 || ! $2 =~ ^[0-9]+$ ]]; then
                printf '%s requires a non-negative integer\n' "$1" >&2
                exit 2
            fi
            hit_limit=$2
            shift 2
            ;;
        -l|--labels)
            if [[ $# -lt 2 || -z $2 ]]; then
                printf '%s requires a comma-separated list of labels\n' "$1" >&2
                exit 2
            fi
            label_list=$2
            shift 2
            ;;
        -o|--output-dir)
            if [[ $# -lt 2 || -z $2 ]]; then
                usage >&2
                exit 2
            fi
            output_dir=$2
            shift 2
            ;;
        --) shift; files+=("$@"); break ;;
        -*) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
        *) files+=("$1"); shift ;;
    esac
done

if ((${#files[@]} < 2)); then
    usage >&2
    exit 2
fi

labels=()
if [[ -n $label_list ]]; then
    if [[ $label_list == *, || $label_list == *[[:cntrl:]]* ]]; then
        printf '%s\n' '--labels requires one non-empty, single-line label per input file' >&2
        exit 2
    fi
    IFS=, read -r -a labels <<< "$label_list"
    if ((${#labels[@]} != ${#files[@]})); then
        printf '%s\n' '--labels requires one label per input file' >&2
        exit 2
    fi
    for label in "${labels[@]}"; do
        if [[ $label != *[![:space:]]* ]]; then
            printf '%s\n' '--labels requires non-empty labels' >&2
            exit 2
        fi
    done
fi

for file in "${files[@]}"; do
    if [[ ! -f $file || ! -r $file ]]; then
        printf 'Cannot read input file: %s\n' "$file" >&2
        exit 2
    fi
done

if [[ -n $output_dir && ( -e $output_dir || -L $output_dir ) ]]; then
    printf 'Choose a new output directory: %s\n' "$output_dir" >&2
    exit 2
fi

export LC_ALL=C
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT

export VENN_LINES_EXPORT=
if [[ -n $output_dir ]]; then
    VENN_LINES_EXPORT=$scratch/output
    mkdir -p -- "$VENN_LINES_EXPORT/pairwise" "$VENN_LINES_EXPORT/splits"
fi

tag_inputs() {
    local index
    for index in "${!files[@]}"; do
        awk -v input="$((index + 1))" '{ print input "\t" $0 }' < "${files[index]}" || return
    done
}

{
    printf 'Inputs\n'
    for index in "${!files[@]}"; do
        printf '  %s  %q\n' "${labels[index]:-$((index + 1))}" "${files[index]}"
    done

    # Sort by full line and then by input number. Repeated lines within an input count once.
    tag_inputs | sort -u -t $'\t' -k2 -k1,1n |
        VENN_LINES_LABELS=$label_list awk -v file_count="${#files[@]}" -v hit_limit="$hit_limit" '
        function append_line(path, text) {
            print text >> path
            close(path)
        }

        function empty_file(path) {
            printf "%s", "" > path
            close(path)
        }

        function tally_line(    split_number, split_size, text, i, j, pair) {
            if (!(membership in split_numbers)) {
                split_numbers[membership] = ++split_count
                split_members[split_count] = membership
            }
            split_number = split_numbers[membership]
            split_size = ++split_sizes[split_number]
            if (member_count == file_count) {
                shared_all++
            }

            if (output != "" || split_size <= hit_limit) {
                text = substr(previous_key, 2)
            }
            if (split_size <= hit_limit) {
                split_hits[split_number, split_size] = text
            }
            if (output != "") {
                append_line(output "/splits/split-" split_number ".txt", text)
                if (member_count == file_count) {
                    append_line(output "/all.txt", text)
                }
            }

            for (i = 1; i < member_count; i++) {
                for (j = i + 1; j <= member_count; j++) {
                    pair = members[i] "-" members[j]
                    pair_sizes[pair]++
                    if (output != "") {
                        append_line(output "/pairwise/" pair ".txt", text)
                    }
                }
            }
        }

        BEGIN {
            output = ENVIRON["VENN_LINES_EXPORT"]
            labeled = split(ENVIRON["VENN_LINES_LABELS"], labels, ",")
            if (!labeled) {
                for (i = 1; i <= file_count; i++) {
                    labels[i] = i
                }
            }
            if (output != "") {
                empty_file(output "/all.txt")
            }
        }

        {
            separator = index($0, "\t")
            # Prefix the key so awk compares numeric-looking lines as strings.
            key = "x" substr($0, separator + 1)
            if (key != previous_key) {
                if (NR > 1) {
                    tally_line()
                }
                previous_key = key
                member_count = 0
                membership = ""
            }

            input = substr($0, 1, separator - 1)
            membership = membership (member_count ? "," : "") input
            members[++member_count] = input
        }

        END {
            if (NR > 0) {
                tally_line()
            }

            printf "\nShared among all: %d\n", shared_all
            printf "\nPairwise overlaps (including lines shared with other inputs)\n"
            for (i = 1; i < file_count; i++) {
                for (j = i + 1; j <= file_count; j++) {
                    pair = i "-" j
                    count = pair_sizes[pair] + 0
                    printf "  %s + %s: %d\n", labels[i], labels[j], count
                    if (output != "" && count == 0) {
                        empty_file(output "/pairwise/" pair ".txt")
                    }
                }
            }

            printf "\nExact splits by input %s\n", (labeled ? "label" : "number")
            for (i = 1; i <= split_count; i++) {
                groups = split_members[i]
                if (labeled) {
                    group_count = split(groups, input_numbers, ",")
                    groups = labels[input_numbers[1]]
                    for (j = 2; j <= group_count; j++) {
                        groups = groups "," labels[input_numbers[j]]
                    }
                }
                printf "  split-%d (%s): %d\n", i, groups, split_sizes[i]
                for (j = 1; j <= hit_limit && j <= split_sizes[i]; j++) {
                    printf "    %s\n", split_hits[i, j]
                }
            }
        }
    '
} > "$scratch/summary.txt"

if [[ -n $output_dir ]]; then
    cp -- "$scratch/summary.txt" "$VENN_LINES_EXPORT/summary.txt"
    mkdir -- "$output_dir"
    cp -R -- "$VENN_LINES_EXPORT/." "$output_dir"
fi

cat -- "$scratch/summary.txt"
